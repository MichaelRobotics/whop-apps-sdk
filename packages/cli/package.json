{
  "name": "@whop-apps-gateway/cli",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "files": ["dist"],
  "repository": { "type": "git", "url": "git+https://github.com/MichaelRobotics/whop-apps-sdk.git", "directory": "packages/cli" },
  "type": "module",
  "description": "Scaffold a Whop app, log in to the gateway, and write MCP client config",
