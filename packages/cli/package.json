      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/cli.test.ts src/connect.test.ts"
  },
  "dependencies": {
    "@types/node": "^22.13.0",
    "@whop-apps-gateway/protocol": "github:MichaelRobotics/whop-apps-sdk#path:packages/protocol",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
